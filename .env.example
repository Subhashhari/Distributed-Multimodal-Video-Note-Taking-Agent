# =============================================================================
#  Video Notes Agent: environment configuration
#  Copy to .env and fill in every value marked  __FILL_ME__
#    cp .env.example .env
#  Values marked (demo) can be changed for a faster live demo.
# =============================================================================

# ----------------------------------------------------------------------------
# Pipeline mode
#   stub = fake transcript/LLM/frames/Notion (no keys needed; tests the plumbing)
#   real = real YouTube + LLM + ffmpeg + Notion   (needs the keys below)
# ----------------------------------------------------------------------------
PIPELINE_MODE=stub

# ----------------------------------------------------------------------------
# Gateway
# ----------------------------------------------------------------------------
GATEWAY_BASE_URL=http://localhost:8080
GATEWAY_PORT=8080
# Comma-separated. After loading the extension, add chrome-extension://<your-extension-id>
CORS_ALLOWED_ORIGINS=chrome-extension://__FILL_ME_EXTENSION_ID__,http://localhost:8080

# ----------------------------------------------------------------------------
# Infrastructure (defaults work with docker-compose as-is)
# ----------------------------------------------------------------------------
POSTGRES_USER=notes
POSTGRES_PASSWORD=notes
POSTGRES_DB=notes
DATABASE_URL=postgresql+asyncpg://notes:notes@postgres:5432/notes

RABBITMQ_DEFAULT_USER=notes
RABBITMQ_DEFAULT_PASS=notes
# Broker connection string
BROKER_URL=amqp://notes:notes@rabbitmq:5672/

REDIS_URL=redis://redis:6379/0

# Create tables automatically at startup (fine for this project; migrations later)
AUTO_CREATE_SCHEMA=true

# ----------------------------------------------------------------------------
# Security
# ----------------------------------------------------------------------------
# Encrypts the Notion token while it sits inside queue messages.
# Generate: python -c "import base64,os;print(base64.urlsafe_b64encode(os.urandom(32)).decode())"
MESSAGE_ENC_KEY=__FILL_ME_GENERATE_A_KEY__
# Bearer token for /admin/* endpoints (DLQ inspection/replay, fault injection)
# Generate: python -c "import secrets;print(secrets.token_urlsafe(24))"
ADMIN_TOKEN=__FILL_ME_GENERATE_A_TOKEN__
# Enables /admin/faults and per-job debug options (demo only; keep false otherwise)
DEMO_FAULTS_ENABLED=true

# ----------------------------------------------------------------------------
# LLM (free by default: Gemini API free tier)
#   Get a key: https://aistudio.google.com/  →  "Get API key"
#   Providers: gemini | ollama | openai_compat | anthropic | openai | mock
# ----------------------------------------------------------------------------
LLM_PROVIDER=gemini
LLM_API_KEY=__FILL_ME_GEMINI_API_KEY__
# Pin an exact model id (check AI Studio for the current free Flash model)
LLM_MODEL=__FILL_ME_GEMINI_FLASH_MODEL_ID__
LLM_VISION_MODEL=
# Only for ollama / openai_compat (e.g. http://ollama:11434, https://api.groq.com/openai/v1)
LLM_BASE_URL=
# Used only if the primary provider's DAILY quota runs out (e.g. ollama)
LLM_FALLBACK_PROVIDER=
LLM_FALLBACK_MODEL=

# Global LLM rate limit shared by ALL workers.
# Set to ~80% of your model's current free-tier limits (0 = unlimited).
LLM_RPM=8
LLM_TPM=200000
LLM_RPD=200
LLM_MAX_CONCURRENCY=2
LLM_CHUNK_TOKENS=12000
LLM_CHUNK_OVERLAP_SEC=15
LLM_MAX_OUTPUT_TOKENS=4000

# Frame captions grounded by a vision call (one batched call per job)
VISION_VERIFY=true
VISION_BATCH_SIZE=8

# ----------------------------------------------------------------------------
# Notion
#   1. https://www.notion.so/my-integrations → New integration → type "Public"
#   2. Redirect URI: https://<your-extension-id>.chromiumapp.org/notion
#   3. Copy the OAuth client id + secret below
#   4. Create a page (e.g. "Video Notes") and share it with the integration
# ----------------------------------------------------------------------------
NOTION_OAUTH_CLIENT_ID=__FILL_ME_NOTION_CLIENT_ID__
NOTION_OAUTH_CLIENT_SECRET=__FILL_ME_NOTION_CLIENT_SECRET__
NOTION_OAUTH_REDIRECT_URI=https://__FILL_ME_EXTENSION_ID__.chromiumapp.org/notion
# Optional: page/database id used when a job has no notion_parent_id
NOTION_DEFAULT_PARENT_ID=
NOTION_VERSION=2022-06-28
NOTION_RPS=2.5

# ----------------------------------------------------------------------------
# YouTube
# ----------------------------------------------------------------------------
YOUTUBE_RPM=30
YOUTUBE_MAX_CONCURRENCY=3
# Optional Netscape-format cookies file if YouTube asks to "confirm you're not a bot"
YTDLP_COOKIES_FILE=
TRANSCRIPT_LANGS=en,en-US,en-GB
WHISPER_FALLBACK=false
WHISPER_MODEL=base

# ----------------------------------------------------------------------------
# Constraints & frames
# ----------------------------------------------------------------------------
MAX_VIDEO_SECONDS=1200
MAX_FRAMES=8
MIN_FRAME_GAP_SEC=20
FRAME_CONCURRENCY=3
FRAME_TIMEOUT_SEC=30

# ----------------------------------------------------------------------------
# Retries, backoff, dead-letter queue
# ----------------------------------------------------------------------------
# Transient-failure budget per job (then → DEAD_LETTERED)
MAX_ATTEMPTS=5
# Rate-limit (HTTP 429) retry budget per stage
RL_MAX_RETRIES=6
# prod → BACKOFF_SCHEDULE_SEC, demo → DEMO_BACKOFF_SCHEDULE_SEC   (demo)
RETRY_PROFILE=prod
BACKOFF_SCHEDULE_SEC=10,30,90
DEMO_BACKOFF_SCHEDULE_SEC=2,4,8
# Broker-level crash-loop protection (quorum queue x-delivery-limit)
BROKER_DELIVERY_LIMIT=5
STAGE_TIMEOUT_SEC=600

# ----------------------------------------------------------------------------
# Worker
# ----------------------------------------------------------------------------
# all | comma list of transcribe,summarize,frames,publish
WORKER_STAGES=all
WORKER_CONCURRENCY=1
WORKER_POLL_INTERVAL_SEC=0.5
SHUTDOWN_GRACE_SEC=25
# Simulated work time per stub stage (stub mode only)
STUB_STAGE_DELAY_SEC=1.0

# ----------------------------------------------------------------------------
# Logging / telemetry
# ----------------------------------------------------------------------------
LOG_LEVEL=INFO
# json | console
LOG_FORMAT=json
OTEL_EXPORTER_OTLP_ENDPOINT=
